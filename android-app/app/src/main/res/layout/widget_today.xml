<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 요약 (4x2). 위: 오늘 수유 · 최근 수유한 지 / 아래: 오늘 수면 · 최근 깬 지 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:includeFontPadding="false"
        android:paddingTop="2dp"
        android:text="오늘"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/tile_feed"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/l_feed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍼 오늘 수유"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/feed_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_feed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/tile_feed"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/l_gap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 최근 수유한 지"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/feed_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/w_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기록 없음"
                android:textColor="@color/widget_ink"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/tile_sleep"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/l_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 오늘 수면"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/sleep_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/tile_wake"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/l_wake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👀 최근 깬 지"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/wake_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_wake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
